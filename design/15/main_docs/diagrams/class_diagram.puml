@startuml class_diagram
skinparam backgroundColor white
skinparam nodesep 40
skinparam ranksep 50
skinparam defaultFontName Microsoft YaHei,SimHei,sans-serif

title Class Diagram — PlayerState 重构 (intention #15)

package "game/player_state.py (NEW)" as PlayerStatePkg {
    enum StatusType {
        DEFENSE = "defense"
        GUARD = "guard"
    }

    class PlayerStatus <<dataclass>> {
        +status_type: StatusType
        +lifetime: int
    }
}

package "game/player.py" as PlayerPkg {
    class Player <<dataclass>> {
        +hp: int
        +energy: int
        +statuses: list~PlayerStatus~
        +hand: list~CardType~
        +draw_pile: list~CardType~
        +discard_pile: list~CardType~
        +history: list~CardType~
        +build_history: list~CardType | None~
        +has_status(StatusType): bool
        +play_card(CardType): None
        +play_cards(list~CardType~): None
        +has_card(CardType): bool
        +has_cards(list~CardType~): bool
        +take_damage(int): None
        +add_energy(int): None
    }
}

package "game/game_core.py" as GameCorePkg {
    class RoundResult <<dataclass>> {
        +round: int
        +cycle: int
        +round_in_cycle: int
        +cards_1: list~CardType~
        +cards_2: list~CardType~
        +damage_1: int
        +damage_2: int
        +hp_1_after: int
        +hp_2_after: int
        +energy_1_after: int
        +energy_2_after: int
        +statuses_1: list~PlayerStatus~
        +statuses_2: list~PlayerStatus~
        +details: list~str~
        +cycle_ended: bool
        +bleed_damage_1: int
        +bleed_damage_2: int
        +after_cycle: int
        +after_round_in_cycle: int
        +after_hp_1: int
        +after_hp_2: int
        +after_statuses_1: list~PlayerStatus~
        +after_statuses_2: list~PlayerStatus~
        +is_game_over: bool
        +winner: str | None
    }

    class GameCore {
        +player_1: Player | None
        +player_2: Player | None
        +round_number: int
        +cycle_number: int
        +round_in_cycle: int
        +is_over: bool
        +winner: str | None
        +round_log: list~RoundResult~
        +start_game(): None
        +play_round(c1, c2, bt1, bt2): RoundResult
        +get_state(perspective): dict
        -_tick_status_lifetimes(): None
    }
}

package "game/resolver.py" as ResolverPkg {
    class ResolutionResult <<dataclass>> {
        +damage_1: int
        +damage_2: int
        +energy_delta_1: int
        +energy_delta_2: int
        +statuses_granted_1: list~StatusType~
        +statuses_granted_2: list~StatusType~
        +details: list~str~
    }

    class CardResolver {
        {static} +resolve(c1, c2, s1, s2, str1, str2): ResolutionResult
        {static} +get_consecutive_attack(history): int
    }
}

package "game/session_store.py" as SessionStorePkg {
    class SessionStore {
        +save(game_id, GameCore, ...): None
        +load(game_id): (GameCore, dict)
        +delete(game_id): bool
    }
}

package "controller/serializers.py" as SerializersPkg {
    class serializers {
        +round_result_to_dict(RoundResult): dict
    }
}

' Dependencies
Player --> PlayerStatus : "statuses: list"
PlayerStatus --> StatusType : "status_type"
GameCore --> Player : "owns"
GameCore --> RoundResult : "produces"
RoundResult --> PlayerStatus : "statuses_*, after_statuses_*"
CardResolver --> ResolutionResult : "returns"
ResolutionResult --> StatusType : "statuses_granted_*"
CardResolver --> PlayerStatus : "resolve() 参数"
SessionStore --> GameCore : "persists"
serializers --> RoundResult : "serializes"

@enduml
