@startuml
skinparam defaultFontName Microsoft YaHei,SimHei,sans-serif
title Policy Output Decode Flow - 13-d to Game Action (design/14)

actor "AppManager\nai_select_action" as App
participant "GRUPolicyModel\nforward" as Model
participant "Converter\npolicy_index_to_action" as C

App -> Model: forward(x(1,1,15), hidden, mask_fn, temperature=0)
Model --> App: probs(1,13), log_probs, new_hidden

App -> App: action_idx = argmax(probs)
note right of App
  probs 13-d interleaved:
  0: build+build | 1: attack | 2: build+attack | ...
end note

App -> C: policy_index_to_action(action_idx)

alt action_idx is odd (1,3,5,7,9,11)
    C --> App: (card_str, None)
    note right of C
      e.g. idx=1 -> ("attack", None)
      e.g. idx=3 -> ("defense", None)
    end note
else action_idx is even (0,2,4,6,8,10,12)
    C --> App: ("build", build_target)
    note right of C
      e.g. idx=0 -> ("build", "build")
      e.g. idx=4 -> ("build", "defense")
    end note
end

App -> App: game.play_round(card_str, build_target)
App --> App: return (card_str, build_target, new_hidden)

@enduml
