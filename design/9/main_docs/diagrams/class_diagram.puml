@startuml
skinparam backgroundColor #FEFEFE
skinparam defaultFontSize 11

title Class Diagram — Split Policy/Value Networks

class TrainScript {
    parse_args()
    load_config()
}

class TrainingConfig {
    sample_path
    policy_output_path
    value_output_path
    model
    epoch
    value_epochs
    policy_lr
    value_lr
    weight_decay
    gamma
    gae_lambda
    clip_eps
    max_grad_norm
    value_coef
    entropy_coef
    batch_size
}

class TrainingRunner {
    run(config)
}

class GRUPolicyModel {
    INITIAL_HIDDEN_STATE
    forward(x, hidden, mask_fn, temperature)
}

class GRUValueModel {
    INITIAL_HIDDEN_STATE
    forward(x, hidden)
}

class Registry {
    get_ai_info(name)
    list_ais()
}

class AppManager {
    ai_select_action(state, hidden, ai_name)
    ai_sample_action(state, h_pol, h_val, ai_name, temp, player_key)
    create_game(mode, ai_name)
    run_selfplay(config)
}

class SelfPlayRunner {
    run(config)
}

class BackendConfig {
    training
}

TrainScript --> TrainingRunner : creates and calls run()
TrainScript --> TrainingConfig : constructs
TrainScript --> BackendConfig : reads
TrainingRunner --> Registry : looks up model
TrainingRunner --> GRUPolicyModel : trains
TrainingRunner --> GRUValueModel : trains
AppManager --> Registry : looks up model
AppManager --> GRUPolicyModel : loads for inference
AppManager --> GRUValueModel : loads for inference
AppManager --> SelfPlayRunner : delegates to
SelfPlayRunner --> AppManager : calls ai_sample_action

@enduml
