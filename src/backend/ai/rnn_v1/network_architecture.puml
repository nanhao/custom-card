@startuml rnn_v1_architecture
skinparam backgroundColor white
skinparam componentStyle rectangle
skinparam nodesep 50
skinparam ranksep 60
skinparam defaultFontName Microsoft YaHei,SimHei,SimSun,sans-serif

title Split Policy/Value Network Architecture\nGRUPolicyModel (333 params) + GRUValueModel (288 params) = 621 total

package "Input Layer" as InputLayer {
    [14-dim feature vector\n(1,1,14)] as Input
    note right of Input
        4 card counts
        2 HP (AI, human)
        4 one-hot AI last move
        4 one-hot human last move
    end note
}

package "GRUPolicyModel" as PolicyModel #LightYellow {
    [GRU(14→8)\nnum_layers=1\n288 params] as PolicyGRU
    [FC(8→4) + softmax\n36 params] as PolicyFC
}

package "GRUValueModel" as ValueModel #LightBlue {
    [GRU(14→8)\nnum_layers=1\n288 params] as ValueGRU
    [FC(8→1)\nno tanh, 9 params] as ValueFC
}

Input -down-> PolicyGRU
Input -down-> ValueGRU

PolicyGRU -down-> PolicyFC
ValueGRU -down-> ValueFC

note bottom of PolicyFC
    Output: (probs, log_probs, new_hidden)
    mask_fn + temperature supported
end note

note bottom of ValueFC
    Output: (value, new_hidden)
    No mask_fn, no temperature
end note

@enduml
